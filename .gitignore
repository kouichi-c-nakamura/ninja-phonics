# ==========================================
# Python 仮想環境 (venv / virtual environments)
# ==========================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ==========================================
# Python キャッシュ・ビルド生成物
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 音声テスト・録音一時ファイル (NinjaPhonetics特有)
# ==========================================
# 録音テストで生成される一時音声ファイル
*.wav
*.mp3
*.m4a
*.ogg
temp_test.wav
temp/
recordings/

# presets ディレクトリ配下の音声ファイルはトラッキング対象にする
!presets/*.wav
!presets/*.mp3
!presets/*.m4a

# PlotlyのHTML出力・エクスポート画像
*.html
!templates/*.html
*.png
*.jpg
*.jpeg

# ==========================================
# 環境変数・APIキー (Gemini API等)
# ==========================================
.env
.env.local
*.env

# ==========================================
# エディタ・OS一時ファイル (macOS / VS Code)
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# PyCharm / JetBrains
.idea/

# Jupyter Notebook キャッシュ
.ipynb_checkpoints
temp.ipynb
